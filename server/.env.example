GEMINI_API_KEY=replace-with-your-server-only-key
# Tried in order when one is busy or out of daily quota.
GEMINI_MODELS=gemini-3.5-flash,gemini-2.5-flash,gemini-3.1-flash-lite
MAX_OUTPUT_TOKENS=1200
THINKING_BUDGET=256
RATE_LIMIT_PER_HOUR=30
ARTICLE_RATE_LIMIT_PER_HOUR=120
# Reverse proxies in front of the server (Render/Cloud Run: 1, direct exposure: 0)
TRUSTED_PROXY_HOPS=1
ALLOWED_ORIGINS=
